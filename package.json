{
	"name": "@plcharriere/svelte-themes",
	"version": "0.3.0",
	"description": "SSR-safe theme switching for SvelteKit 2 + Svelte 5. Plain CSS themes, cookie-persisted, prefers-color-scheme aware, with live cross-tab sync.",
	"keywords": [
		"svelte",
		"sveltekit",
		"theme",
		"themes",
		"theming",
		"dark-mode",
		"prefers-color-scheme",
		"ssr",
		"typescript"
	],
	"license": "MIT",
	"author": "Paul-Louis Charrière",
	"homepage": "https://github.com/plcharriere/svelte-themes",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plcharriere/svelte-themes.git"
	},
	"bugs": {
		"url": "https://github.com/plcharriere/svelte-themes/issues"
	},
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": false
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.59.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.6",
		"publint": "^0.3.18",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.7",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.10",
		"vitest": "^4.1.6",
		"wrangler": "^4.87.0"
	}
}
